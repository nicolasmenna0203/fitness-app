# Copiá a .env.local. Las dos primeras se generan con: node scripts/crear-clave.mjs

# Hash scrypt de la contraseña de la app (nunca la contraseña en sí). ADR 0008.
APP_PASSWORD_HASH=scrypt.<sal>.<hash>
# Secreto aleatorio para firmar la cookie de sesión. Rotarlo cierra todas las sesiones.
SESSION_SECRET=...
