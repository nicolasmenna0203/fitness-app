# Copiá a .env.local. En Vercel van todas en Production.

# Login (ADR 0008). Se generan con: node scripts/crear-clave.mjs
# Hash scrypt de la contraseña de la app (nunca la contraseña en sí).
APP_PASSWORD_HASH=scrypt.<sal>.<hash>
# Secreto aleatorio para firmar la cookie de sesión. Rotarlo cierra todas las sesiones.
SESSION_SECRET=

# Base de datos (ADR 0009). Las crea la integración de Neon en Vercel.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Google Health API (ADR 0002). Del cliente OAuth "Aplicación web" en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes aleatorios en base64url: cifra el refresh token guardado en la base.
TOKEN_KEY=
# Secreto que Vercel manda al cron de sincronización.
CRON_SECRET=

# Opcional: zona horaria para agrupar los datos por día (por defecto Buenos Aires).
# ZONA_HORARIA=America/Argentina/Buenos_Aires
